{
  "name": "streamtv",
  "version": "3.18.0",
  "private": true,
  "type": "module",
  "description": "Catalogue vidéo web à trois entrées : chaînes en direct, animés, films.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/serveur.js",
    "admin": "node server/administration.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "versionner": "node scripts/versionner.js --ecrire",
    "versionner:check": "node scripts/versionner.js --verifier",
    "controle:lignes": "node scripts/controle-lignes.js",
    "importer": "node scripts/importer.mjs",
    "statique": "node scripts/construire-statique.mjs",
    "publier": "node scripts/construire-statique.mjs --base /streamtv --sortie docs --conserver ADMINISTRATION.md",
    "statique:servir": "node scripts/construire-statique.mjs --servir",
    "verify": "node scripts/verify.js"
  }
}
